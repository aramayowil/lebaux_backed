{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS", // <--- Genera código compatible con require()
    "moduleResolution": "node", // <--- Busca archivos sin necesidad de .js
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true, // Permite usar 'import' en vez de 'require' en TS
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false // Permite que Vercel genere los archivos finales
  },
  "include": ["src/**/*"]
}
